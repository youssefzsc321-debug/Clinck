@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null; // صفحة مستقلة بذاتها لتفادي أخطاء الـ Layout المفقود
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinck</title>

    <!-- روابط ملفات التصميم الخاصة بميترونك وبوتستراب -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/plugins/global/plugins.bundle.css" />
    <link rel="stylesheet" href="~/assets/css/style.bundle.css" />
</head>
<body id="kt_body" class="app-blank bgi-size-cover bgi-position-center bgi-no-repeat">

    <div class="d-flex flex-column flex-root" id="kt_app_root">
        <!--begin::Authentication - Sign-in -->
        <div class="d-flex flex-column flex-column-fluid bgi-size-cover bgi-position-center" style="background-image: url('/assets/media/auth/bg4.jpg')">
            <div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
               
                <!--begin::Logo-->
                <a href="~/" class="mb-12">
                    <img alt="Logo" src="~/Images/ChatGPT Image Sep 21, 2026, 06_09_35 PM.png" class="h-40px" />
                </a>
                <!--end::Logo-->
                <!--begin::Wrapper-->
                <div class="w-lg-500px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto">

                    <form id="account" method="post" class="form w-100">

                        <!--begin::Heading-->
                        <div class="text-center mb-10">
                            <h1 class="text-dark fw-bolder mb-3">Sign In to Clinck</h1>
                            <div class="text-gray-500 fw-semibold fs-6">Enter your username or email below</div>
                        </div>
                        <!--end::Heading-->

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!--begin::Input group=-->
                        <div class="fv-row mb-8">
                            <label asp-for="Input.UserName" class="form-label fs-6 fw-bold text-dark">UserName or Email</label>
                            <input asp-for="Input.UserName" class="form-control form-control-solid" autocomplete="username" placeholder="name@example.com / username" />
                            <span asp-validation-for="Input.UserName" class="text-danger mt-2"></span>
                        </div>
                        <!--end::Input group-->
                        <!--begin::Input group-->
                        <div class="fv-row mb-3">
                            <div class="d-flex flex-stack mb-2">
                                <label asp-for="Input.Password" class="form-label fw-bold text-dark fs-6 mb-0">Password</label>
                                <a id="forgot-password" asp-page="./ForgotPassword" class="link-primary fs-6 fw-bold">Forgot Password ?</a>
                            </div>
                            <input asp-for="Input.Password" class="form-control form-control-solid" autocomplete="current-password" placeholder="Password" />
                            <span asp-validation-for="Input.Password" class="text-danger mt-2"></span>
                        </div>
                        <!--end::Input group-->
                        <!--begin::Wrapper-->
                        <div class="d-flex flex-stack flex-wrap fs-base fw-semibold mb-8">
                            <div class="form-check form-check-custom form-check-solid">
                                <input class="form-check-input" type="checkbox" asp-for="Input.RememberMe" />
                                <label class="form-check-label" asp-for="Input.RememberMe">
                                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                                </label>
                            </div>
                        </div>
                        <!--end::Wrapper-->
                        <!--begin::Submit button-->
                        <div class="d-grid mb-10">
                            <button type="submit" id="login-submit" class="btn btn-primary">
                                <!--begin::Indicator label-->
                                <span class="indicator-label">Sign In</span>
                                <!--end::Indicator label-->
                            </button>
                        </div>
                        <!--end::Submit button-->
                        <!--begin::Sign up-->
                        <div class="text-gray-500 text-center fw-semibold fs-6">
                            Not a Member yet?
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="link-primary fw-bold">Sign up</a>
                        </div>
                        <!--end::Sign up-->

                    </form>

                </div>
                <!--end::Wrapper-->

            </div>
        </div>
        <!--end::Authentication - Sign-in-->
    </div>

    <!-- السكربتات الأساسية وملفات التحقق -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/plugins/global/plugins.bundle.js"></script>
    <script src="~/assets/js/scripts.bundle.js"></script>
    <partial name="_ValidationScriptsPartial" />

</body>
</html>