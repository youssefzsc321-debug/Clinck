@model Clinck.Application.ViewModels.UserVms.UserVm
@{
    var initial = !string.IsNullOrEmpty(Model.FullName) ? Model.FullName[0].ToString().ToUpper() : "U";
}

<tr>
    <!-- Full Name & Avatar -->
    <td class="ps-4">
        <div class="d-flex align-items-center">
            <div class="user-avatar me-3 fw-bold bg-light-primary text-primary d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px;">
                @initial
            </div>
            <div class="d-flex flex-column">
                <span class="text-dark fw-bold text-hover-primary fs-6">@Model.FullName</span>
            </div>
        </div>
    </td>

    <!-- UserName -->
    <td>
        <span class="text-gray-800 fw-semibold">@Model.UserName</span>
    </td>

    <!-- Email -->
    <td>
        <span class="text-gray-600">@Model.Email</span>
    </td>

    <!-- Status Badge -->
    <td>
        @if (Model.IsDeleted)
        {
            <span class="badge badge-light-danger text-danger fw-bold px-3 py-2 js-status-badge">
                <i class="fa-solid fa-circle-xmark me-1 text-danger"></i> Inactive
            </span>
        }
        else
        {
            <span class="badge badge-light-success text-success fw-bold px-3 py-2 js-status-badge">
                <i class="fa-solid fa-circle-check me-1 text-success"></i> Active
            </span>
        }
    </td>

    <!-- Created On -->
    <td class="text-muted fs-7" data-order="@(Model.CreatedOn.HasValue ? Model.CreatedOn.Value.ToString("yyyyMMddHHmmss") : "0")">
        @(Model.CreatedOn.HasValue ? Model.CreatedOn.Value.ToString("MMM dd, yyyy") : "-")
    </td>

    <!-- Last Updated -->
    <td class="text-muted fs-7 js-updated-on" data-order="@(Model.LastUpdatedOn.HasValue ? Model.LastUpdatedOn.Value.ToString("yyyyMMddHHmmss") : "0")">
        @(Model.LastUpdatedOn.HasValue ? Model.LastUpdatedOn.Value.ToString("MMM dd, yyyy") : "-")
    </td>

    <!-- Actions Dropdown -->
    <td class="pe-4 text-end">
        <div class="dropdown">
            <button class="btn btn-sm btn-light btn-active-light-primary px-3" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-ellipsis-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                <li>
                    <a href="@Url.Action("Edit", "User", new { id = Model.Id })" class="dropdown-item py-2">
                        <i class="fa-solid fa-pen-to-square me-2 text-warning"></i> Edit
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a href="javascript:;"
                       class="dropdown-item py-2 text-danger js-toggle-status"
                       data-url="@Url.Action("ToggleStatus", "User", new { id = Model.Id })">
                        <i class="fa-solid fa-arrows-rotate me-2"></i> Toggle Status
                    </a>
                </li>
            </ul>
        </div>
    </td>
</tr>