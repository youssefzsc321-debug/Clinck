@model IEnumerable<Clinck.Application.ViewModels.Appointment.GetApointments>
<!--begin::Card-->
<div class="card card-flush shadow-sm mb-5">
    <!--begin::Card header-->
    <div class="card-header pt-7 align-items-center">
        <!--begin::Title-->
        <h3 class="card-title align-items-start flex-column">
            <span class="card-label fw-bold text-gray-800 fs-3">Patient Appointments</span>
            <span class="text-muted mt-1 fw-semibold fs-7">List of all scheduled and past appointments</span>
        </h3>
        <!--end::Title-->
        <!--begin::Toolbar-->
        <div class="card-toolbar">
            @{
                var patientId = Model.FirstOrDefault()?.PatientId ?? ViewBag.PatientId;
            }
            <a asp-controller="Appointment" asp-action="Create" asp-route-patientId="@patientId" class="btn btn-sm btn-flex btn-primary fw-bold">
                <i class="ki-duotone ki-plus fs-2 me-2">
                    <span class="path1"></span>
                    <span class="path2"></span>
                    <span class="path3"></span>
                </i>Add Appointment
            </a>
        </div>
        <!--end::Toolbar-->
    </div>
    <!--end::Card header-->
    <!--begin::Card body-->
    <div class="card-body pt-3">
        <!--begin::Table container-->
        <div class="table-responsive">
            <!--begin::Table-->
            <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_patients_appointments">
                <!--begin::Table head-->
                <thead>
                    <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                        <th class="min-w-175px">Doctor & Department</th>
                        <th class="min-w-125px">Appointment Date</th>
                        <th class="min-w-100px">Status</th>
                        <th class="min-w-100px">Created On</th>
                        <th class="text-end min-w-150px">Actions</th>
                    </tr>
                </thead>
                <!--end::Table head-->
                <!--begin::Table body-->
                <tbody class="text-gray-600 fw-semibold">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <!-- Doctor & Department -->
                                <td>
                                    <div class="d-flex align-items-center">
                                        <!-- Symbol / Avatar with glow effect -->
                                        <div class="symbol symbol-circle symbol-50px overflow-hidden me-3">
                                            <div class="symbol-label fs-3 bg-light-primary text-primary fw-bold">
                                                @(item.Doctor?.Length >= 2 ? item.Doctor.Substring(0, 2).ToUpper() : "DR")
                                            </div>
                                        </div>
                                        <div class="d-flex flex-column">
                                            <span class="text-gray-800 fw-bold mb-1">@item.Doctor</span>
                                            <span class="text-muted fs-7">@item.Department</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Appointment Date -->
                                <td>
                                    <span class="text-gray-800 fw-bold d-block fs-6">@item.AppointmentDate.ToString("yyyy-MM-dd")</span>
                                    <span class="text-muted fw-semibold fs-7">@item.AppointmentDate.ToString("hh:mm tt")</span>
                                </td>

                                <!-- Status Badge -->
                                <td>
                                    @if (item.AppointmentState == Clinck.Domain.Enums.AppointmentState.Scheduled)
                                    {
                                        <span class="badge badge-light-primary fs-7 fw-bold px-4 py-3">Scheduled</span>
                                    }
                                    else if (item.AppointmentState == Clinck.Domain.Enums.AppointmentState.Completed)
                                    {
                                        <span class="badge badge-light-success fs-7 fw-bold px-4 py-3">Completed</span>
                                    }
                                    else if (item.AppointmentState == Clinck.Domain.Enums.AppointmentState.Cancelled)
                                    {
                                        <span class="badge badge-light-danger fs-7 fw-bold px-4 py-3">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light-secondary fs-7 fw-bold px-4 py-3">@item.AppointmentState</span>
                                    }
                                </td>

                                <!-- Created On -->
                                <td>
                                    <span class="text-gray-600 fw-semibold fs-7">@item.CreatedOn.ToString("yyyy-MM-dd")</span>
                                </td>

                                <!-- Actions -->
                                <td class="text-end" id="action-cell-@item.Id">
                                    @if (item.AppointmentState == Clinck.Domain.Enums.AppointmentState.Scheduled)
                                    {
                                        <div class="d-flex justify-content-end flex-shrink-0">
                                            <!-- Complete Button -->
                                            <a href="javascript:;"
                                               class="btn btn-sm btn-light-success me-1 px-3 py-2 update-state-btn"
                                               title="Mark as Completed"
                                               data-url="@Url.Action("ChangeState", "Appointment", new { id = item.Id, cancel = false })"
                                               data-state="completed">
                                                <i class="fas fa-check fs-6 me-1"></i> Complete
                                            </a>

                                            <!-- Cancel Button -->
                                            <a href="javascript:;"
                                               class="btn btn-sm btn-light-danger px-3 py-2 update-state-btn"
                                               title="Cancel Appointment"
                                               data-url="@Url.Action("ChangeState", "Appointment", new { id = item.Id, cancel = true })"
                                               data-state="cancelled">
                                                <i class="fas fa-times fs-6 me-1"></i> Cancel
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-7">No Actions</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-10">
                                <div class="text-muted fw-semibold fs-6">No appointments found for this patient.</div>
                            </td>
                        </tr>
                    }
                </tbody>
                <!--end::Table body-->
            </table>
            <!--end::Table-->
        </div>
        <!--end::Table container-->
    </div>
    <!--end::Card body-->
</div>
<!--end::Card-->

@section Scripts {
    <script>
        $(document).on('click', '.update-state-btn', function () {
            let btn = $(this);
            let url = btn.data('url');
            let stateType = btn.data('state'); // 'completed' أو 'cancelled'

            let row = btn.closest('tr');
            let actionCell = btn.closest('td');
            let badgeCell = row.find('td:nth-child(3)');

            $.ajax({
                url: url,
                type: 'POST',
                success: function (response) {
                    let badgeHtml = '';
                    let newActionsHtml = '<span class="text-muted fs-7">No Actions</span>';

                    if (stateType === 'completed') {
                        badgeHtml = '<span class="badge badge-light-success fs-7 fw-bold px-4 py-3">Completed</span>';
                        toastr.success("Appointment marked as completed successfully!");
                    } else {
                        badgeHtml = '<span class="badge badge-light-danger fs-7 fw-bold px-4 py-3">Cancelled</span>';
                        toastr.success("Appointment cancelled successfully!");
                    }

                    badgeCell.html(badgeHtml);
                    actionCell.html(newActionsHtml);
                },
                error: function () {
                    toastr.error("An error occurred while updating the state.");
                }
            });
        });
    </script>
}