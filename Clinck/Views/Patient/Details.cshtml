@model Clinck.Application.ViewModels.PatientVms.GetPatients

@{
    ViewData["Title"] = "Patient Details";
    var hasImage = !string.IsNullOrEmpty(Model.ImageThumnail);
}

<!--begin::Layout Builder / Container-->
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
            <!--begin::Page title-->
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">Patient Profile</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted">
                        <a asp-controller="Home" asp-action="Index" class="text-muted text-hover-primary">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a asp-controller="Patient" asp-action="Index" class="text-muted text-hover-primary">Patients</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-dark">Profile Overview</li>
                </ul>
            </div>
            <!--end::Page title-->
            <!--begin::Actions-->
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <a asp-action="Index" class="btn btn-sm btn-flex bg-body btn-color-gray-700 btn-active-color-primary fw-bold border-0 shadow-sm">
                    <i class="bi bi-arrow-left fs-4 me-1"></i> Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary fw-bold">
                    <i class="bi bi-pencil-square fs-4 me-1"></i> Edit Profile
                </a>
            </div>
            <!--end::Actions-->
        </div>
    </div>
    <!--end::Toolbar-->
    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-xxl">

            <!--begin::Navbar-->
            <div class="card mb-5 mb-xl-10 shadow-sm">
                <div class="card-body pt-9 pb-0">
                    <!--begin::Details-->
                    <div class="d-flex flex-wrap flex-sm-nowrap">
                        <!--begin: Pic-->
                        <div class="me-7 mb-4">
                            <div class="symbol symbol-100px symbol-lg-160px symbol-fixed position-relative">
                                <img src="@(hasImage ? Model.ImageThumnail : "~/Images/download.png")" alt="Patient Image" class="object-fit-cover rounded-circle shadow" />
                                <div class="position-absolute translate-middle bottom-0 start-100 mb-6 bg-success rounded-circle border border-4 border-body h-20px w-20px" title="Active Patient"></div>
                            </div>
                        </div>
                        <!--end::Pic-->
                        <!--begin::Info-->
                        <div class="flex-grow-1">
                            <!--begin::Title-->
                            <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                                <!--begin::User-->
                                <div class="d-flex flex-column">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="text-gray-900 text-hover-primary fs-2 fw-bold me-1">@Model.FullName</span>
                                        <span class="badge badge-light-@(Model.Gender == Clinck.Domain.Enums.Gender.Male ? "primary" : "danger") fs-8 fw-bold ms-2">@Model.Gender</span>
                                    </div>
                                    <div class="d-flex flex-wrap fw-semibold fs-6 mb-4 pe-2">
                                        <span class="d-flex align-items-center text-gray-400 text-hover-primary me-5 mb-2">
                                            <i class="bi bi-envelope fs-4 me-1"></i>@(string.IsNullOrEmpty(Model.Email) ? "No Email Provided" : Model.Email)
                                        </span>
                                        <span class="d-flex align-items-center text-gray-400 text-hover-primary me-5 mb-2">
                                            <i class="bi bi-telephone fs-4 me-1"></i>@(string.IsNullOrEmpty(Model.Phone) ? "No Phone Provided" : Model.Phone)
                                        </span>
                                        <span class="d-flex align-items-center text-gray-400 text-hover-primary mb-2">
                                            <i class="bi bi-geo-alt fs-4 me-1"></i>@Model.Address
                                        </span>
                                    </div>
                                </div>
                                <!--end::User-->
                                <!--begin::Actions-->
                                <div class="d-flex my-4">
                                    <a asp-controller="Appointment" asp-action="Create" asp-route-patientId="@Model.Id"
                                       class="btn btn-sm btn-light-primary me-3">
                                        <i class="bi bi-calendar-plus fs-3 me-1"></i> Add Appointment
                                    </a>
                                </div>
                                <!--end::Actions-->
                            </div>
                            <!--end::Title-->
                            <!--begin::Stats-->
                            <div class="d-flex flex-wrap flex-stack">
                                <div class="d-flex flex-column flex-grow-1 pe-8">
                                    <div class="d-flex flex-wrap">
                                        <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-cake2 fs-2 text-success me-2"></i>
                                                <div class="fs-6 fw-bold text-gray-700">@Model.DateOfBirth.ToString("dd-MM-yyyy")</div>
                                            </div>
                                            <div class="fw-semibold fs-7 text-gray-400">Date of Birth</div>
                                        </div>
                                        <div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-shield-exclamation fs-2 text-danger me-2"></i>
                                                <div class="fs-6 fw-bold text-gray-700">@(string.IsNullOrEmpty(Model.MedicalHistory) ? "None" : "Recorded")</div>
                                            </div>
                                            <div class="fw-semibold fs-7 text-gray-400">Medical Status</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--end::Stats-->
                        </div>
                        <!--end::Info-->
                    </div>
                    <!--end::Details-->
                </div>
            </div>
            <!--end::Navbar-->
            <!--begin::Details Overview Box-->
            <div class="card mb-5 mb-xl-10 shadow-sm">
                <div class="card-header cursor-pointer d-flex align-items-center justify-content-between">
                    <div class="card-title m-0">
                        <h3 class="fw-bold m-0"><i class="bi bi-person-lines-fill text-primary me-2"></i> Profile Details</h3>
                    </div>
                    <div>
                        <a asp-controller="Appointment" asp-action="Index" asp-route-patientId="@Model.Id"
                           class="btn btn-sm btn-light-info">
                            <i class="bi bi-calendar-check fs-3 me-1"></i> View Appointments
                        </a>
                    </div>
                </div>
                <div class="card-body p-9">
                    <div class="row mb-7">
                        <label class="col-lg-4 fw-semibold text-muted">Full Name</label>
                        <div class="col-lg-8">
                            <span class="fw-bold fs-6 text-gray-850">@Model.FullName</span>
                        </div>
                    </div>
                    <div class="row mb-7">
                        <label class="col-lg-4 fw-semibold text-muted">Phone Number</label>
                        <div class="col-lg-8 fv-row">
                            <span class="fw-semibold text-gray-800 fs-6">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</span>
                        </div>
                    </div>
                    <div class="row mb-7">
                        <label class="col-lg-4 fw-semibold text-muted">Email Address</label>
                        <div class="col-lg-8">
                            <span class="fw-semibold text-gray-800 fs-6">@(string.IsNullOrEmpty(Model.Email) ? "-" : Model.Email)</span>
                        </div>
                    </div>
                    <div class="row mb-7">
                        <label class="col-lg-4 fw-semibold text-muted">Gender</label>
                        <div class="col-lg-8">
                            <span class="fw-semibold text-gray-800 fs-6">@Model.Gender</span>
                        </div>
                    </div>
                    <div class="row mb-7">
                        <label class="col-lg-4 fw-semibold text-muted">Address</label>
                        <div class="col-lg-8">
                            <span class="fw-semibold text-gray-800 fs-6">@Model.Address</span>
                        </div>
                    </div>
                    <div class="row mb-7">
                        <label class="col-lg-4 fw-semibold text-muted">Medical History</label>
                        <div class="col-lg-8">
                            <p class="fw-semibold text-gray-800 fs-6 bg-light-warning p-4 rounded border border-warning border-dashed">
                                @(string.IsNullOrEmpty(Model.MedicalHistory) ? "No significant medical history recorded for this patient." : Model.MedicalHistory)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Details Overview Box-->

        </div>
    </div>
    <!--end::Content-->
</div>